# LinuxServer WireGuard Server 配置 / server environment.
# 复制到 /etc/wireguard-manager/wireguard-server.env 后修改。
PUID=10001
PGID=10001
TZ=Asia/Shanghai

# 必填：客户端能访问的服务器公网域名或 IP，不带协议、不带端口。
# Required: public hostname/IP without http://, https://, or a port.
SERVERURL=vpn.example.invalid
SERVERPORT=51820

# 新安装保留一个 bootstrap Peer，占用 10.44.0.2；manager.env 必须保留该地址。
# The bootstrap peer owns .2, which must remain reserved in manager.env.
PEERS=bootstrap
INTERNAL_SUBNET=10.44.0.0
ALLOWEDIPS=10.44.0.0/24
PEERDNS=auto
# 不在普通日志中显示完整配置或二维码 / keep configs and QR codes out of logs.
LOG_CONFS=false
UMASK=077
