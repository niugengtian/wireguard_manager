# WireGuard Manager Web/CLI + reconciler 共用配置 / shared environment.
# 复制到 /etc/wireguard-manager/manager.env 后修改。
TZ=Asia/Shanghai

WG_MANAGER_DATA_DIR=/var/lib/wireguard-manager
WG_TUNNEL_CIDR=10.44.0.0/24
WG_RESERVED_IPS=10.44.0.2
WG_ALLOWED_IPS=10.44.0.0/24
WG_DNS=

# 必填：与 wireguard-server.env 的 SERVERURL/SERVERPORT 一致，不带 URL 协议。
# Required: the same public endpoint and UDP port, without a URL scheme.
WG_ENDPOINT=vpn.example.invalid:51820
WG_INTERFACE=wg0
WG_ADAPTER=reconciler
WG_RECONCILE_SOCKET=/run/wireguard-manager/reconcile.sock
WG_RECONCILE_STATE_DIR=/var/lib/wireguard-manager-reconciler
WG_SERVER_PUBLIC_KEY_FILE=/var/lib/wireguard-manager-reconciler/server-public-key
WG_RECONCILE_TIMEOUT_SECONDS=5
WG_RESET_ACTIVATION_DELAY_SECONDS=2

# 上述 Socket/状态目录是固定挂载契约，改值时必须同步修改 docker run 挂载。
# Socket/state paths are mount contracts; keep docker run mounts in sync.

# Web 仅监听 WireGuard 隧道地址，不发布公网 TCP 端口。
# Web binds only the tunnel address and does not publish host TCP 8081.
WG_WEB_HOST=10.44.0.1
WG_WEB_PORT=8081
# 仅隧道内 HTTP 用 0；Nginx HTTPS 终止后改 1。
# Use 0 only for in-tunnel HTTP; set 1 behind HTTPS termination.
WG_COOKIE_SECURE=0
WG_SESSION_MINUTES=30
WG_CONTAINER_STARTUP_TIMEOUT_SECONDS=90
